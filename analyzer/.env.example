# Copy to .env and fill in. Never commit real keys.

# Comma-separated pool of Gemini API keys. A random healthy key is used per request; a key that hits its
# quota rests and is skipped, an invalid key is rejected until restart. Keys stay on this server only.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash,gemini-3-flash-preview
GEMINI_TIMEOUT_S=45

# Optional shared secrets the mobile / web clients must send as X-API-Key
ANALYZER_API_KEYS=

# Browser origins allowed to call the API (the Next.js web portal)
ALLOWED_ORIGINS=http://localhost:3000

MAX_UPLOAD_MB=10
ANALYZER_WORKERS=2
OCR_LANG=en
# Paddle oneDNN CPU acceleration (defaults to off on Windows, where Paddle 3.x crashes with it)
# OCR_MKLDNN=false
# Text-detector input size cap (px). Lower = faster on CPU.
OCR_DET_LIMIT=1600
# Lighter CPU models (optional)
# OCR_DET_MODEL=PP-OCRv5_mobile_det
# OCR_REC_MODEL=en_PP-OCRv5_mobile_rec
# Physical side length of the printed ArUco marker (DICT_4X4_50, id 0 recommended)
ARUCO_MARKER_MM=20
# true = numeral-height check goes to REVIEW (instead of N/A) when no marker is in the frame
REQUIRE_CALIBRATION=false
KEEP_WORKSPACE=false
